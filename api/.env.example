# Copiar como .env y llenar. El archivo .env NUNCA se sube a GitHub (en el servidor: chmod 600 .env).

# Puerto público del equipo (80XX)
PUERTO=8004

# --- Opción A: leer Oro directo de S3 (lo que pide el enunciado) ---
# Ruta donde el notebook Gold_pronostico copia las tablas (parámetro ruta_oro_s3 del Job)
GOLD_URI=s3://cc3105-au-869227452861-us-east-2-an/equipo4/gold
# Credenciales de SOLO LECTURA del bucket Oro. Si están vacías se usa la opción B.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# --- Opción B: leer Oro por el SQL warehouse de Databricks ---
DATABRICKS_HOST=https://dbc-26b0ea61-5062.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=f9ddac1315643f52
DATABRICKS_CATALOGO=equipo4
DATABRICKS_ESQUEMA=gold
# Token personal (Settings -> Developer -> Access tokens). Solo en el .env del servidor.
DATABRICKS_TOKEN=

# Segundos que la API guarda las tablas en memoria antes de volver a leerlas
CACHE_SEGUNDOS=300

# Ventana de prueba que muestra /modelo/metricas (ultimas_52, ultimas_104 o ultimas_156)
ESCENARIO_METRICAS=ultimas_104
