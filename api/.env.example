# Copiar como .env y llenar. El archivo .env NUNCA se sube a GitHub (en el servidor: chmod 600 .env).

# Puerto público del equipo (80XX)
PUERTO=8004

# Dónde están las tablas Oro (Delta):
#   para probar en tu computadora:  /app/datos_ejemplo
#   en el servidor:                 s3://<bucket-oro>/equipo-04/gold   (lo mismo que el widget ruta_oro_s3 del notebook Gold)
GOLD_URI=/app/datos_ejemplo

# Credenciales de SOLO LECTURA del bucket Oro (solo hacen falta si GOLD_URI empieza con s3://)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# Segundos que la API guarda las tablas en memoria antes de volver a leer S3
CACHE_SEGUNDOS=300

# Ventana de prueba que muestra /modelo/metricas (ultimas_52, ultimas_104 o ultimas_156)
ESCENARIO_METRICAS=ultimas_104
